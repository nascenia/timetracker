%h2
  %b
    Employee Details
%br

%div#device-type-indicator(style='font-weight: bold; color: #007bff; margin-bottom: 10px;')
  Detecting device...

= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'form-horizontal', method: :put }) do |f|
  = devise_error_messages!
  %fieldset
    %legend
      Basic
      %span.required-asterisk *
    .form-group
      = f.label 'Supervisor/TTF', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.select :ttf_id, User.active.ttf.map{|u| [u.name, u.id]}, {}, { class: 'form-control' , required: true }
    .form-group
      = f.label :name, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :name, { class: 'form-control' , required: true}
    .form-group
      = f.label :date_of_birth, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :date_of_birth, { class: 'form-control date-picker' , required: true}
    .form-group
      = f.label :blood_group, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.select :blood_group, User::BLOOD_GROUPS, {}, { class: 'form-control' , required: true}
    .form-group
      = f.label :joining_date, { class: 'col-sm-2 control-label' }
      .col-sm-10
        = f.text_field :joining_date, { class: 'form-control date-picker' , required: true}
  %br
  %fieldset
    %legend
      Contact Information
      %span.required-asterisk *
    .form-group
      = f.label :personal_email, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.email_field :personal_email, { class: 'form-control' , required: true,  pattern: '[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$', title: 'Enter a valid email address!' }
    .form-group
      = f.label :present_address, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_area :present_address, { class: 'form-control', required: true}
    .form-group
      = f.label :mobile_number, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :mobile_number, { class: 'form-control', required: true, :pattern => '[0][1][3-9][0-9]{8}', :title => 'Enter a valid mobile number!'}
    .form-group
      = f.label :alternate_contact, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :alternate_contact, { class: 'form-control', required: false, :pattern => '[0][1][3-9][0-9]{8}', :title => 'Enter a valid mobile number!'}
    .form-group
      = f.label :permanent_address, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_area :permanent_address, { class: 'form-control', required: true}
  %br
  %fieldset
    %legend
      Last Degree
      %span.required-asterisk *
    .form-group
      = f.label :last_degree, 'Name', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :last_degree, { class: 'form-control', required: true}
    .form-group
      = f.label :last_university, 'University', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :last_university, { class: 'form-control', required: true}
    .form-group
      = f.label :passing_year, 'Year', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :passing_year, { class: 'form-control', required: true, :pattern => '[1-2][0-9]{3}', :title => 'Enter a valid year!'}
  %br
  %fieldset
    %legend
      Emergency Contact Person
      %span.required-asterisk *
    .form-group
      = f.label :emergency_contact_person_name, 'Name', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :emergency_contact_person_name, { class: 'form-control', required: true}
    .form-group
      = f.label :emergency_contact_person_relation, 'Relation', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :emergency_contact_person_relation, { class: 'form-control', required: true}
    .form-group
      = f.label :emergency_contact_person_number, 'Number', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :emergency_contact_person_number, { class: 'form-control', required: true, :pattern => '[0][1][3-9][0-9]{8}', :title => 'Enter a valid mobile number!'}
  %br
  %fieldset
    %legend DBBL Bank Information (if exists)
    .form-group
      = f.label :bank_account_no, 'Account Number', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :bank_account_no, { class: 'form-control'}
  %br
  %fieldset
    %legend Upload Photo and Document
    .form-group
      = f.label :avatar, 'Image' , { class: 'col-sm-2 control-label'} do
        = 'Image'
        %span.required-asterisk *
      - if f.object.avatar.url.present?
        .col-sm-6
          = f.file_field :avatar, { class: 'form-control', required: false}
          %br/
        .col-sm-4
          .img-responsive.profile_image
            = image_tag f.object.avatar.url(:medium)
      - else
        .col-sm-10
          = f.file_field :avatar, { onchange: 'validateAvatar(this);', data: { max_file_size: 50.megabytes },  class: 'form-control', required: true}
    .form-group
      = f.label :resume, 'CV' , { class: 'col-sm-2 control-label' } do
        = 'CV'
        %span.required-asterisk *
      .col-sm-10
        - if @user.resume.present?
          = link_to 'Current CV', @user.resume.url, { class: 'link', target: :_blank}
          %br
            = f.file_field :resume, { onchange: 'validateFiles(this);', data: { max_file_size: 50.megabytes },  class: 'form-control', required: false}
        - else
          = f.file_field :resume, { onchange: 'validateFiles(this);', data: { max_file_size: 50.megabytes },  class: 'form-control', required: true}
    .form-group
      = f.label :national_id, 'National ID / Birth Certificate' , { class: 'col-sm-2 control-label'} do
        = 'National ID / Birth Certificate'
        %span.required-asterisk *
      .col-sm-10
        - if @user.national_id.present?
          = link_to 'Current NID / Birth Certificate', @user.national_id.url, { class: 'link', target: :_blank}
          %br  
            = f.file_field :national_id, { onchange: 'validateFiles(this);', data: { max_file_size: 50.megabytes },  class: 'form-control'}
        - else
          = f.file_field :national_id, { onchange: 'validateFiles(this);', data: { max_file_size: 50.megabytes },  class: 'form-control', required: true}
    .form-group
      = f.label :passport, 'Passport' , { class: 'col-sm-2 control-label'} do
        = 'Passport'
      .col-sm-10
        - if @user.passport.present?
          = link_to 'Current Passport', @user.passport.url, { class: 'link', target: :_blank}   
          %br        
        = f.file_field :passport, { onchange: 'validateFiles(this);', data: { max_file_size: 50.megabytes },  class: 'form-control'}
  %br
  %fieldset
    %legend Face Recognition Setup
    .form-group
      .col-sm-2
        %h5 Face Registration
      .col-sm-10
        - if current_user.face_encoding_pc.present?
          .alert.alert-success
            %strong Face data registered!
            %br
            You can update your face data by clicking the button below.
          %br
        = button_tag 'Register/Update Face', type: 'button', class: 'btn btn-primary', id: 'register-face-btn', data: { toggle: 'modal', target: '#faceRegistrationModal' }
        %br
        %small.text-muted
          This will capture your face for check-in/out using facial recognition.
  %br
  .form-group
    .col-sm-2.col-sm-10
      = f.submit 'Submit',  class: 'btn btn-success'

/ Face Registration Modal
#faceRegistrationModal.modal.fade{tabindex: '-1', :role => 'dialog', 'aria-labelledby' => 'faceRegistrationModalLabel'}
  .modal-dialog.modal-lg{:role => 'document'}
    .modal-content
      .modal-header
        %button.close{type: 'button', 'data-dismiss' => 'modal', 'aria-label' => 'Close'}
          %span{'aria-hidden' => 'true'} &times;
        %h4.modal-title#faceRegistrationModalLabel Register Your Face
      .modal-body
        .row
          .col-xs-12.col-md-8
            .video-container.text-center{style: 'width: 100%; max-width: 200px; margin: 0 auto;'}
              %video#video{autoplay: true, muted: true, playsinline: true, style: 'width: 100%; height: auto; aspect-ratio: 1 / 1; border-radius: 50%; object-fit: cover; background: #222; box-shadow: 0 0 0 4px #fff, 0 0 8px 0 #888;'}
            .canvas-container.text-center{style: 'display: none; width: 100%; max-width: 200px; margin: 0 auto;'}
              %canvas#canvas{width: '200', height: '200', style: 'width: 100%; height: auto; aspect-ratio: 1 / 1; border-radius: 50%; object-fit: cover; background: #222; box-shadow: 0 0 0 4px #fff, 0 0 8px 0 #888;'}
            .text-center
              #auto-face-status-message.alert{style: 'display: none; margin-top: 10px;'}
              %button#capture-photo-btn.btn.btn-primary{type: 'button', style: 'margin: 10px 5px;'} Capture
              %button#retake-photo-btn.btn.btn-warning{type: 'button', style: 'margin: 10px 5px; display: none;'} Retake
              %button#next-photo-btn.btn.btn-info{type: 'button', style: 'margin: 10px 5px; display: none;'} Take Next Photo
              %button#see-best-shot-btn.btn.btn-secondary{type: 'button', style: 'margin: 10px 5px; display: none;'} See Best Shot
              %button#register-face-btn-modal.btn.btn-success{type: 'button', style: 'margin: 10px 5px; display: none;'} Register Face
          .col-xs-12.col-md-4
            .instructions
              %h5 Instructions:
              %ol
                %li Click "Start Camera" to begin
                %li Position your face in the center of the frame
                %li Ensure good lighting
                %li Look straight at the camera
                %li The photo will be captured automatically when ready
            .status-messages
              #status-message.alert{style: 'display: none;'}
      .modal-footer
        %button.btn.btn-default{type: 'button', 'data-dismiss' => 'modal'} Close
        %button#start-camera-btn.btn.btn-primary.btn-block{type: 'button', style: 'font-size: 1.2em; padding: 10px;'} Start Camera

:plain
  <script type="module">
    import * as vision from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision/vision_bundle.js";
    window.vision = vision;
    $(document).ready(function() {
      var video = document.getElementById('video');
      var canvas = document.getElementById('canvas');
      var ctx = canvas.getContext('2d');
      var stream = null;
      var userId = #{current_user.id};
      var photoTaken = false;
      var capturedPhotos = [];
      var faceLandmarker = null;
      var lastCaptureData = null;
      var maxPhotos = 3;
      var deviceType = isMobileDevice() ? 'mb' : 'pc';

      async function loadFaceLandmarker() {
        if (!faceLandmarker) {
          const visionWasm = await vision.FilesetResolver.forVisionTasks(
            'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@latest/wasm'
          );
          faceLandmarker = await vision.FaceLandmarker.createFromOptions(visionWasm, {
            baseOptions: { modelAssetPath: 'https://storage.googleapis.com/mediapipe-assets/face_landmarker.task' },
            runningMode: 'IMAGE',
            numFaces: 1,
            minFaceDetectionConfidence: 0.8,
            minFacePresenceConfidence: 0.8,
            minTrackingConfidence: 0.8
          });
        }
      }

      function showAutoFaceStatus(message, type) {
        $('#auto-face-status-message')
          .removeClass()
          .addClass('alert alert-' + type)
          .text(message)
          .show();
      }
      function hideAutoFaceStatus() {
        $('#auto-face-status-message').hide();
      }

      function showVideo() {
        $('.video-container').show();
        $('.canvas-container').hide();
        $('#capture-photo-btn').show();
        $('#retake-photo-btn').hide();
        $('#next-photo-btn').hide();
        $('#see-best-shot-btn').hide();
        $('#register-face-btn-modal').hide();
        photoTaken = false;
      }
      function showCanvas() {
        $('.video-container').hide();
        $('.canvas-container').show();
        $('#capture-photo-btn').hide();
        $('#retake-photo-btn').show();
        if (capturedPhotos.length < maxPhotos - 1) {
          $('#next-photo-btn').show();
          $('#see-best-shot-btn').hide();
          $('#register-face-btn-modal').hide();
        } else if (capturedPhotos.length === maxPhotos - 1) {
          $('#next-photo-btn').hide();
          $('#see-best-shot-btn').show();
          $('#register-face-btn-modal').show();
        }
        photoTaken = true;
      }
      function updateStatusCounter() {
        showAutoFaceStatus('Photo ' + (capturedPhotos.length + 1) + ' of ' + maxPhotos, 'info');
      }

      $('#start-camera-btn').click(function() {
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
          navigator.mediaDevices.getUserMedia({ 
            video: { 
              width: { ideal: 640 },
              height: { ideal: 480 },
              facingMode: 'user'
            } 
          })
          .then(function(mediaStream) {
            stream = mediaStream;
            video.srcObject = mediaStream;
            video.play();
            $('#start-camera-btn').hide();
            showVideo();
            updateStatusCounter();
            hideAutoFaceStatus();
          })
          .catch(function(err) {
            showAutoFaceStatus('Error accessing camera. Please check permissions.', 'danger');
          });
        } else {
          showAutoFaceStatus('Camera not supported in this browser.', 'danger');
        }
      });

      $('#capture-photo-btn').click(async function() {
        // Get actual displayed size of video element
        const displayWidth = video.clientWidth;
        const displayHeight = video.clientHeight;

        // Set canvas resolution to match displayed size (adjust for high-DPI screens)
        const dpr = window.devicePixelRatio || 1;
        canvas.width = displayWidth * dpr;
        canvas.height = displayHeight * dpr;
        canvas.style.width = `${displayWidth}px`;
        canvas.style.height = `${displayHeight}px`;

        // Calculate video's intrinsic aspect ratio
        const videoRatio = video.videoWidth / video.videoHeight;
        const displayRatio = displayWidth / displayHeight;

        // Determine source cropping coordinates
        let sx, sy, sw, sh;

        if (videoRatio > displayRatio) {
            // Video is wider than display: crop left/right
            sw = video.videoHeight * displayRatio;
            sh = video.videoHeight;
            sx = (video.videoWidth - sw) / 2;
            sy = 0;
        } else {
            // Video is taller than display: crop top/bottom
            sw = video.videoWidth;
            sh = video.videoWidth / displayRatio;
            sx = 0;
            sy = (video.videoHeight - sh) / 2;
        }

        // Draw only the visible portion of the video
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(
            video, 
            sx, sy, sw, sh,          // Source rectangle (cropped portion)
            0, 0, canvas.width, canvas.height  // Destination (full canvas)
        );
        // Save the image data for later
        lastCaptureData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        showCanvas();
        hideAutoFaceStatus();
      });

      $('#retake-photo-btn').click(function() {
        lastCaptureData = null;
        showVideo();
        updateStatusCounter();
        hideAutoFaceStatus();
      });

      $('#next-photo-btn').click(function() {
        if (lastCaptureData) {
          // Store the photo as a dataURL for later
          var tempCanvas = document.createElement('canvas');
          tempCanvas.width = canvas.width;
          tempCanvas.height = canvas.height;
          tempCanvas.getContext('2d').putImageData(lastCaptureData, 0, 0);
          capturedPhotos.push(tempCanvas.toDataURL('image/jpeg', 1));
          lastCaptureData = null;
        }
        if (capturedPhotos.length < maxPhotos) {
          showVideo();
          updateStatusCounter();
          hideAutoFaceStatus();
        }
      });

      $('#see-best-shot-btn').click(async function() {
        await loadFaceLandmarker();
        if (lastCaptureData && capturedPhotos.length < maxPhotos) {
          // Accept the last photo if not already accepted
          var tempCanvas = document.createElement('canvas');
          tempCanvas.width = canvas.width;
          tempCanvas.height = canvas.height;
          tempCanvas.getContext('2d').putImageData(lastCaptureData, 0, 0);
          capturedPhotos.push(tempCanvas.toDataURL('image/jpeg', 1));
        }
        if (capturedPhotos.length !== maxPhotos) {
          showAutoFaceStatus('Please capture all 3 photos.', 'warning');
          return;
        }
        // Find the best photo using MediaPipe FaceLandmarker
        let bestScore = -Infinity;
        let bestIndex = 0;
        for (let i = 0; i < capturedPhotos.length; i++) {
          let img = new window.Image();
          img.src = capturedPhotos[i];
          await new Promise(resolve => { img.onload = resolve; });
          let tempCanvas = document.createElement('canvas');
          tempCanvas.width = canvas.width;
          tempCanvas.height = canvas.height;
          let tempCtx = tempCanvas.getContext('2d');
          tempCtx.drawImage(img, 0, 0, tempCanvas.width, tempCanvas.height);
          let results = faceLandmarker.detect(tempCanvas);
          let score = 0;
          if (results.faceLandmarks && results.faceLandmarks.length > 0) {
            const landmarks = results.faceLandmarks[0];
            const leftEye = landmarks[33];
            const rightEye = landmarks[263];
            const noseTip = landmarks[1];
            const eyeDiffY = Math.abs(leftEye.y - rightEye.y);
            const minEyeX = Math.min(leftEye.x, rightEye.x);
            const maxEyeX = Math.max(leftEye.x, rightEye.x);
            const noseBetweenEyes = (noseTip.x > minEyeX && noseTip.x < maxEyeX);
            const faceCentered = Math.abs(noseTip.x - 0.5) < 0.1;
            score = 1 - eyeDiffY;
            if (noseBetweenEyes) score += 1;
            if (faceCentered) score += 1;
            let imageData = tempCtx.getImageData(0, 0, tempCanvas.width, tempCanvas.height);
            let sharpness = 0;
            for (let j = 0; j < imageData.data.length; j += 4) {
              sharpness += Math.abs(imageData.data[j] - imageData.data[j+1]) + Math.abs(imageData.data[j] - imageData.data[j+2]);
            }
            score += sharpness / (imageData.data.length * 2);
          }
          if (score > bestScore) {
            bestScore = score;
            bestIndex = i;
          }
        }
        // Show the best photo in the canvas
        let bestImg = new window.Image();
        bestImg.src = capturedPhotos[bestIndex];
        await new Promise(resolve => { bestImg.onload = resolve; });
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(bestImg, 0, 0, canvas.width, canvas.height);
        showAutoFaceStatus('Best shot selected and shown!', 'success');
      });

      $('#register-face-btn-modal').click(async function() {
        if (lastCaptureData && capturedPhotos.length < maxPhotos) {
          // Accept the last photo if not already accepted
          var tempCanvas = document.createElement('canvas');
          tempCanvas.width = canvas.width;
          tempCanvas.height = canvas.height;
          tempCanvas.getContext('2d').putImageData(lastCaptureData, 0, 0);
          capturedPhotos.push(tempCanvas.toDataURL('image/jpeg', 1));
        }
        if (capturedPhotos.length !== maxPhotos) {
          showAutoFaceStatus('Please capture all 3 photos.', 'warning');
          return;
        }
        await loadFaceLandmarker();
        // Find the best photo using MediaPipe FaceLandmarker
        let bestScore = -Infinity;
        let bestIndex = 0;
        for (let i = 0; i < capturedPhotos.length; i++) {
          let img = new window.Image();
          img.src = capturedPhotos[i];
          await new Promise(resolve => { img.onload = resolve; });
          let tempCanvas = document.createElement('canvas');
          tempCanvas.width = canvas.width;
          tempCanvas.height = canvas.height;
          let tempCtx = tempCanvas.getContext('2d');
          tempCtx.drawImage(img, 0, 0, tempCanvas.width, tempCanvas.height);
          let imageBitmap = tempCanvas;
          let results = faceLandmarker.detect(tempCanvas);
          let score = 0;
          if (results.faceLandmarks && results.faceLandmarks.length > 0) {
            // Score: prefer straight, centered, sharp faces
            const landmarks = results.faceLandmarks[0];
            const leftEye = landmarks[33];
            const rightEye = landmarks[263];
            const noseTip = landmarks[1];
            const eyeDiffY = Math.abs(leftEye.y - rightEye.y);
            const minEyeX = Math.min(leftEye.x, rightEye.x);
            const maxEyeX = Math.max(leftEye.x, rightEye.x);
            const noseBetweenEyes = (noseTip.x > minEyeX && noseTip.x < maxEyeX);
            const faceCentered = Math.abs(noseTip.x - 0.5) < 0.1;
            score = 1 - eyeDiffY;
            if (noseBetweenEyes) score += 1;
            if (faceCentered) score += 1;
            // Sharpness: use edge detection (simple Laplacian)
            let imageData = tempCtx.getImageData(0, 0, tempCanvas.width, tempCanvas.height);
            let sharpness = 0;
            for (let j = 0; j < imageData.data.length; j += 4) {
              sharpness += Math.abs(imageData.data[j] - imageData.data[j+1]) + Math.abs(imageData.data[j] - imageData.data[j+2]);
            }
            score += sharpness / (imageData.data.length * 2);
          }
          if (score > bestScore) {
            bestScore = score;
            bestIndex = i;
          }
        }
        // Convert best photo dataURL to blob
        function dataURLtoBlob(dataurl) {
          var arr = dataurl.split(','), mime = arr[0].match(/:(.*?);/)[1], bstr = atob(arr[1]), n = bstr.length, u8arr = new Uint8Array(n);
          while(n--){
            u8arr[n] = bstr.charCodeAt(n);
          }
          return new Blob([u8arr], {type:mime});
        }
        var bestPhotoBlob = dataURLtoBlob(capturedPhotos[bestIndex]);
        var formData = new FormData();
        formData.append('image', bestPhotoBlob, 'capture.jpg');
        formData.append('user_id', userId);
        formData.append('device_type', deviceType);
        fetch('/api/face/register', {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(function(response) {
          if (response.success) {
            showAutoFaceStatus('Face registered successfully!', 'success');
            setTimeout(function() {
              $('#faceRegistrationModal').modal('hide');
              location.reload();
            }, 2000);
          } else {
            showAutoFaceStatus('Face registration failed: ' + response.error, 'danger');
          }
        })
        .catch(function(error) {
          showAutoFaceStatus('Error registering face: ' + error, 'danger');
        });
      });

      $('#faceRegistrationModal').on('hidden.bs.modal', function() {
        if (stream) {
          stream.getTracks().forEach(function(track) {
            track.stop();
          });
          stream = null;
        }
        $('#start-camera-btn').show();
        showVideo();
        capturedPhotos = [];
        lastCaptureData = null;
        updateStatusCounter();
        hideAutoFaceStatus();
      });
    });

    // Device detection
    function isMobileDevice() {
      return /Mobi|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    }
    document.addEventListener('DOMContentLoaded', function() {
      var indicator = document.getElementById('device-type-indicator');
      if (indicator) {
        indicator.textContent = isMobileDevice() ? 'phone' : 'computer';
      }
    });
  </script>
