%h2
  %b
    Employee Details
%br

= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'form-horizontal', method: :put }) do |f|
  = devise_error_messages!
  %fieldset
    %legend
      Basic
      %span.required-asterisk *
    .form-group
      = f.label 'Supervisor/TTF', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.select :ttf_id, User.active.ttf.map{|u| [u.name, u.id]}, {}, { class: 'form-control' , required: true }
    .form-group
      = f.label :name, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :name, { class: 'form-control' , required: true}
    .form-group
      = f.label :date_of_birth, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :date_of_birth, { class: 'form-control date-picker' , required: true}
    .form-group
      = f.label :blood_group, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.select :blood_group, User::BLOOD_GROUPS, {}, { class: 'form-control' , required: true}
    .form-group
      = f.label :joining_date, { class: 'col-sm-2 control-label' }
      .col-sm-10
        = f.text_field :joining_date, { class: 'form-control date-picker' , required: true}
  %br
  %fieldset
    %legend
      Contact Information
      %span.required-asterisk *
    .form-group
      = f.label :personal_email, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.email_field :personal_email, { class: 'form-control' , required: true,  pattern: '[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$', title: 'Enter a valid email address!' }
    .form-group
      = f.label :present_address, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_area :present_address, { class: 'form-control', required: true}
    .form-group
      = f.label :mobile_number, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :mobile_number, { class: 'form-control', required: true, :pattern => '[0][1][3-9][0-9]{8}', :title => 'Enter a valid mobile number!'}
    .form-group
      = f.label :alternate_contact, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :alternate_contact, { class: 'form-control', required: false, :pattern => '[0][1][3-9][0-9]{8}', :title => 'Enter a valid mobile number!'}
    .form-group
      = f.label :permanent_address, { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_area :permanent_address, { class: 'form-control', required: true}
  %br
  %fieldset
    %legend
      Last Degree
      %span.required-asterisk *
    .form-group
      = f.label :last_degree, 'Name', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :last_degree, { class: 'form-control', required: true}
    .form-group
      = f.label :last_university, 'University', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :last_university, { class: 'form-control', required: true}
    .form-group
      = f.label :passing_year, 'Year', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :passing_year, { class: 'form-control', required: true, :pattern => '[1-2][0-9]{3}', :title => 'Enter a valid year!'}
  %br
  %fieldset
    %legend
      Emergency Contact Person
      %span.required-asterisk *
    .form-group
      = f.label :emergency_contact_person_name, 'Name', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :emergency_contact_person_name, { class: 'form-control', required: true}
    .form-group
      = f.label :emergency_contact_person_relation, 'Relation', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :emergency_contact_person_relation, { class: 'form-control', required: true}
    .form-group
      = f.label :emergency_contact_person_number, 'Number', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :emergency_contact_person_number, { class: 'form-control', required: true, :pattern => '[0][1][3-9][0-9]{8}', :title => 'Enter a valid mobile number!'}
  %br
  %fieldset
    %legend DBBL Bank Information (if exists)
    .form-group
      = f.label :bank_account_no, 'Account Number', { class: 'col-sm-2 control-label'}
      .col-sm-10
        = f.text_field :bank_account_no, { class: 'form-control'}
  %br
  %fieldset
    %legend Upload Photo and Document
    .form-group
      = f.label :avatar, 'Image' , { class: 'col-sm-2 control-label'} do
        = 'Image'
        %span.required-asterisk *
      - if f.object.avatar.url.present?
        .col-sm-6
          = f.file_field :avatar, { class: 'form-control', required: false}
          %br/
        .col-sm-4
          .img-responsive.profile_image
            = image_tag f.object.avatar.url(:medium)
      - else
        .col-sm-10
          = f.file_field :avatar, { onchange: 'validateAvatar(this);', data: { max_file_size: 50.megabytes },  class: 'form-control', required: true}
    .form-group
      = f.label :resume, 'CV' , { class: 'col-sm-2 control-label' } do
        = 'CV'
        %span.required-asterisk *
      .col-sm-10
        - if @user.resume.present?
          = link_to 'Current CV', @user.resume.url, { class: 'link', target: :_blank}
          %br
            = f.file_field :resume, { onchange: 'validateFiles(this);', data: { max_file_size: 50.megabytes },  class: 'form-control', required: false}
        - else
          = f.file_field :resume, { onchange: 'validateFiles(this);', data: { max_file_size: 50.megabytes },  class: 'form-control', required: true}
    .form-group
      = f.label :national_id, 'National ID / Birth Certificate' , { class: 'col-sm-2 control-label'} do
        = 'National ID / Birth Certificate'
        %span.required-asterisk *
      .col-sm-10
        - if @user.national_id.present?
          = link_to 'Current NID / Birth Certificate', @user.national_id.url, { class: 'link', target: :_blank}
          %br  
            = f.file_field :national_id, { onchange: 'validateFiles(this);', data: { max_file_size: 50.megabytes },  class: 'form-control'}
        - else
          = f.file_field :national_id, { onchange: 'validateFiles(this);', data: { max_file_size: 50.megabytes },  class: 'form-control', required: true}
    .form-group
      = f.label :passport, 'Passport' , { class: 'col-sm-2 control-label'} do
        = 'Passport'
      .col-sm-10
        - if @user.passport.present?
          = link_to 'Current Passport', @user.passport.url, { class: 'link', target: :_blank}   
          %br        
        = f.file_field :passport, { onchange: 'validateFiles(this);', data: { max_file_size: 50.megabytes },  class: 'form-control'}
  %br
  %fieldset
    %legend Face Recognition Setup
    .form-group
      .col-sm-2
        %h5 Face Registration
      .col-sm-10
        - if current_user.face_encoding.present?
          .alert.alert-success
            %strong Face data registered!
            %br
            You can update your face data by clicking the button below.
          %br
        = button_tag 'Register/Update Face', type: 'button', class: 'btn btn-primary', id: 'register-face-btn', data: { toggle: 'modal', target: '#faceRegistrationModal' }
        %br
        %small.text-muted
          This will capture your face for check-in/out using facial recognition.
  %br
  .form-group
    .col-sm-2.col-sm-10
      = f.submit 'Submit',  class: 'btn btn-success'

/ Face Registration Modal
#faceRegistrationModal.modal.fade{tabindex: '-1', :role => 'dialog', 'aria-labelledby' => 'faceRegistrationModalLabel'}
  .modal-dialog.modal-lg{:role => 'document'}
    .modal-content
      .modal-header
        %button.close{type: 'button', 'data-dismiss' => 'modal', 'aria-label' => 'Close'}
          %span{'aria-hidden' => 'true'} &times;
        %h4.modal-title#faceRegistrationModalLabel Register Your Face
      .modal-body
        .row
          .col-xs-12.col-md-8
            .video-container.text-center{style: 'width: 100%; max-width: 400px; margin: 0 auto;'}
              %video#video{autoplay: true, muted: true, playsinline: true, style: 'width: 100%; height: auto; border-radius: 8px; background: #222;'}
            .canvas-container.text-center{style: 'display: none; width: 100%; max-width: 400px; margin: 0 auto;'}
              %canvas#canvas{width: '400', height: '300', style: 'width: 100%; height: auto; border-radius: 8px; background: #222;'}
            .text-center
              #auto-face-status-message.alert{style: 'display: none; margin-top: 10px;'}
          .col-xs-12.col-md-4
            .instructions
              %h5 Instructions:
              %ol
                %li Click "Start Camera" to begin
                %li Position your face in the center of the frame
                %li Ensure good lighting
                %li Look straight at the camera
                %li The photo will be captured automatically when ready
            .status-messages
              #status-message.alert{style: 'display: none;'}
      .modal-footer
        %button.btn.btn-default{type: 'button', 'data-dismiss' => 'modal'} Close
        %button#start-camera-btn.btn.btn-primary.btn-block{type: 'button', style: 'font-size: 1.2em; padding: 10px;'} Start Camera

:plain
  <script type="module">
    import * as vision from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision/vision_bundle.js";
    window.vision = vision;
    $(document).ready(function() {
      var video = document.getElementById('video');
      var canvas = document.getElementById('canvas');
      var ctx = canvas.getContext('2d');
      var stream = null;
      var autoCaptureActive = false;
      var faceLandmarker = null;
      var lastVideoTime = -1;
      var userId = #{current_user.id};

      async function loadFaceLandmarker() {
        const visionWasm = await vision.FilesetResolver.forVisionTasks(
          'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@latest/wasm'
        );
        faceLandmarker = await vision.FaceLandmarker.createFromOptions(visionWasm, {
          baseOptions: { modelAssetPath: 'https://storage.googleapis.com/mediapipe-assets/face_landmarker.task' },
          runningMode: 'VIDEO',
          numFaces: 1,
          minFaceDetectionConfidence: 0.8,
          minFacePresenceConfidence: 0.8,
          minTrackingConfidence: 0.8
        });
      }

      function showAutoFaceStatus(message, type) {
        $('#auto-face-status-message')
          .removeClass()
          .addClass('alert alert-' + type)
          .text(message)
          .show();
      }
      function hideAutoFaceStatus() {
        $('#auto-face-status-message').hide();
      }

      async function startAutoCapture() {
        if (!faceLandmarker) await loadFaceLandmarker();
        autoCaptureActive = true;
        showAutoFaceStatus('Align your face to the camera. Waiting for a clear, straight face...', 'info');
        requestAnimationFrame(autoCaptureLoop);
      }

      async function autoCaptureLoop() {
        if (!autoCaptureActive) return;
        if (video.readyState < 2) {
          requestAnimationFrame(autoCaptureLoop);
          return;
        }
        if (!faceLandmarker) {
          requestAnimationFrame(autoCaptureLoop);
          return;
        }
        if (video.currentTime === lastVideoTime) {
          requestAnimationFrame(autoCaptureLoop);
          return;
        }
        lastVideoTime = video.currentTime;
        const results = faceLandmarker.detectForVideo(video, performance.now());
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        if (results.faceLandmarks && results.faceLandmarks.length > 0) {
          // Check if face is straight and centered
          const landmarks = results.faceLandmarks[0];
          const leftEye = landmarks[33];
          const rightEye = landmarks[263];
          const noseTip = landmarks[1];
          const eyeDiffY = Math.abs(leftEye.y - rightEye.y);
          const minEyeX = Math.min(leftEye.x, rightEye.x);
          const maxEyeX = Math.max(leftEye.x, rightEye.x);
          const noseBetweenEyes = (noseTip.x > minEyeX && noseTip.x < maxEyeX);
          const faceCentered = Math.abs(noseTip.x - 0.5) < 0.1;
          if (eyeDiffY < 0.03 && noseBetweenEyes && faceCentered) {
            showAutoFaceStatus('Face detected and aligned! Capturing...', 'success');
            autoCaptureActive = false;
            setTimeout(captureAndSubmit, 500);
            return;
          } else {
            showAutoFaceStatus('Please look straight at the camera and center your face.', 'warning');
          }
        } else {
          showAutoFaceStatus('No face detected. Please align your face.', 'danger');
        }
        requestAnimationFrame(autoCaptureLoop);
      }

      function captureAndSubmit() {
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        canvas.toBlob(function(blob) {
          var formData = new FormData();
          formData.append('image', blob, 'capture.jpg');
          formData.append('user_id', userId);
          fetch('/api/face/register', {
            method: 'POST',
            body: formData
          })
          .then(response => response.json())
          .then(function(response) {
            if (response.success) {
              showAutoFaceStatus('Face registered successfully!', 'success');
              setTimeout(function() {
                $('#faceRegistrationModal').modal('hide');
                location.reload();
              }, 2000);
            } else {
              showAutoFaceStatus('Face registration failed: ' + response.error, 'danger');
              autoCaptureActive = true;
              requestAnimationFrame(autoCaptureLoop);
            }
          })
          .catch(function(error) {
            showAutoFaceStatus('Error registering face: ' + error, 'danger');
            autoCaptureActive = true;
            requestAnimationFrame(autoCaptureLoop);
          });
        }, 'image/jpeg', 0.8);
      }

      $('#start-camera-btn').click(function() {
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
          navigator.mediaDevices.getUserMedia({ 
            video: { 
              width: { ideal: 640 },
              height: { ideal: 480 },
              facingMode: 'user'
            } 
          })
          .then(function(mediaStream) {
            stream = mediaStream;
            video.srcObject = mediaStream;
            video.play();
            $('#start-camera-btn').hide();
            startAutoCapture();
          })
          .catch(function(err) {
            showAutoFaceStatus('Error accessing camera. Please check permissions.', 'danger');
          });
        } else {
          showAutoFaceStatus('Camera not supported in this browser.', 'danger');
        }
      });

      $('#faceRegistrationModal').on('hidden.bs.modal', function() {
        if (stream) {
          stream.getTracks().forEach(function(track) {
            track.stop();
          });
          stream = null;
        }
        $('.video-container').show();
        $('.canvas-container').hide();
        $('#start-camera-btn').show();
        autoCaptureActive = false;
        hideAutoFaceStatus();
      });
    });
  </script>
