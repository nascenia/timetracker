.text-center.custom-font
  %h1 Nascenia Time & Leave Tracker
  %p Set a new password for your account.
  %hr

.row
  .col-md-4.col-md-offset-4
    = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
      = devise_error_messages!
      = f.hidden_field :reset_password_token
      .form-group
        = f.label :password, 'New password'
        .password-toggle-wrapper
          = f.password_field :password, autofocus: true, autocomplete: 'off', class: 'form-control', id: 'change_password'
          %span.password-toggle-icon{data: { toggle: '#change_password' }}
            %i.fa.fa-eye-slash
      .form-group
        = f.label :password_confirmation, 'Confirm new password'
        .password-toggle-wrapper
          = f.password_field :password_confirmation, autocomplete: 'off', class: 'form-control', id: 'change_password_confirmation'
          %span.password-toggle-icon{data: { toggle: '#change_password_confirmation' }}
            %i.fa.fa-eye-slash
      .form-group
        = f.submit 'Change my password', class: 'btn btn-primary btn-block'
    .text-center
      = link_to 'Back to sign in', new_user_session_path

:javascript
  $(document).on('click', '.password-toggle-icon', function () {
    var input = $($(this).data('toggle'));
    var icon = $(this).find('i');
    if (input.attr('type') === 'password') {
      input.attr('type', 'text');
      icon.removeClass('fa-eye-slash').addClass('fa-eye');
    } else {
      input.attr('type', 'password');
      icon.removeClass('fa-eye').addClass('fa-eye-slash');
    }
  });
