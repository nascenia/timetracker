.text-center.custom-font
  %h1 Nascenia Time & Leave Tracker
  %p Time & Leave tracking made smart!
  %hr

.row
  .col-md-4.col-md-offset-4
    = link_to 'Sign in with Google', user_omniauth_authorize_path(:google_oauth2), :class => 'btn btn-block btn-primary'

%h3.text-center Or

.row
  .col-md-4.col-md-offset-4
    = form_for(resource, as: resource_name, url: session_path(resource_name), class: 'form-horizontal') do |f|
      .form-group    
        = f.label :email
        = f.email_field :email, autofocus: true, class: 'form-control'
      .form-group
        .flex-space-between
          = f.label :password
          = link_to 'Forgot Password?', '#', data: { toggle: 'modal', target: '#forgotPasswordModal' }
        .password-toggle-wrapper
          = f.password_field :password, autocomplete: 'off', class: 'form-control', id: 'sign_in_password'
          %span.password-toggle-icon{data: { toggle: '#sign_in_password' }}
            %i.fa.fa-eye-slash
      .form-group
        = f.submit 'Sign In', class: 'btn btn-primary btn-block'

#forgotPasswordModal.modal.fade{tabindex: -1, role: 'dialog', aria: { labelledby: 'forgotPasswordModalLabel', hidden: true }}
  .modal-dialog{role: 'document'}
    .modal-content
      = form_for(resource, as: resource_name, url: password_path(resource_name), remote: true, html: { method: :post, id: 'forgot-password-form' }) do |f|
        .modal-header
          %button.close{type: 'button', data: { dismiss: 'modal' }, aria: { label: 'Close' }}
            %span{aria: { hidden: true }} &times;
          %h4#forgotPasswordModalLabel.modal-title Forgot Password?
        .modal-body
          #forgot-password-message
          .form-group
            = f.label :email
            = f.email_field :email, class: 'form-control', placeholder: 'Enter your email address', autofocus: true
        .modal-footer
          = f.submit 'Send Reset Instructions', class: 'btn btn-primary', id: 'forgot-password-submit'
          %button.btn.btn-default{type: 'button', data: { dismiss: 'modal' }} Cancel

.text-center.custom-font
  %p Start timers and easily manage your existing time entries in just one tap.

:javascript
  $(document).on('click', '.password-toggle-icon', function () {
    var input = $($(this).data('toggle'));
    var icon = $(this).find('i');
    if (input.attr('type') === 'password') {
      input.attr('type', 'text');
      icon.removeClass('fa-eye-slash').addClass('fa-eye');
    } else {
      input.attr('type', 'password');
      icon.removeClass('fa-eye').addClass('fa-eye-slash');
    }
  });

  $('#forgotPasswordModal').on('hidden.bs.modal', function () {
    $('#forgot-password-form')[0].reset();
    $('#forgot-password-message').empty();
    $('#forgot-password-form .form-group').show();
    $('#forgot-password-submit').show();
  });
