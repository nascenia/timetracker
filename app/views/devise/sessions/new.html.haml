- content_for :head do
  %meta{name: "viewport", content: "width=device-width, initial-scale=1"}

.text-center.custom-font
  %h1 Nascenia Time & Leave Tracker
  %p Time & Leave tracking made smart!
  %hr

.row
  .col-md-4.col-md-offset-4
    = link_to 'Sign in with Google', user_omniauth_authorize_path(:google_oauth2), :class => 'btn btn-block btn-primary'

%h3.text-center Or

.row
  .col-md-4.col-md-offset-4
    = form_for(resource, as: resource_name, url: session_path(resource_name), class: 'form-horizontal') do |f|
      .form-group    
        = f.label :email
        = f.email_field :email, autofocus: true, class: 'form-control'
      .form-group
        = f.label :password
        = f.password_field :password, autocomplete: 'off', class: 'form-control'
      .form-group
        = f.submit 'Sign In', class: 'btn btn-primary btn-block'

// Face Check-In Button
.text-center
  %button#face-checkin-btn.btn.btn-success{type: 'button', style: 'margin-top: 20px;'}
    Face Check-In (with Camera)

// Face Check-In Modal
#faceCheckInModal.modal.fade{tabindex: '-1', :role => 'dialog', 'aria-labelledby' => 'faceCheckInModalLabel'}
  .modal-dialog.modal-lg{:role => 'document'}
    .modal-content
      .modal-header
        %button.close{type: 'button', 'data-dismiss' => 'modal', 'aria-label' => 'Close'}
          %span{'aria-hidden' => 'true'} &times;
        %h4.modal-title#faceCheckInModalLabel Face Check-In
      .modal-body
        .row
          .col-xs-12.col-md-8
            .video-container.text-center{style: 'width: 100%; max-width: 400px; margin: 0 auto;'}
              %video#face-video{autoplay: true, muted: true, playsinline: true, style: 'width: 100%; height: auto; border-radius: 8px; background: #222;'}
            .canvas-container.text-center{style: 'display: none; width: 100%; max-width: 400px; margin: 0 auto;'}
              %canvas#face-canvas{width: '400', height: '300', style: 'width: 100%; height: auto; border-radius: 8px; background: #222;'}
            .text-center
              // Removed manual capture/retake/recognize buttons
            .text-center
              #auto-face-status-message.alert{style: 'display: none; margin-top: 10px;'}
          .col-xs-12.col-md-4
            .instructions
              %h5 Instructions:
              %ol
                %li Click "Start Camera" to begin
                %li Position your face in the center of the frame
                %li Ensure good lighting
                %li Look straight at the camera
                %li The photo will be captured automatically when ready
            .status-messages
              #face-status-message.alert{style: 'display: none;'}
      .modal-footer
        %button.btn.btn-default{type: 'button', 'data-dismiss' => 'modal'} Close
        %button#face-start-camera-btn.btn.btn-primary.btn-block{type: 'button', style: 'font-size: 1.2em; padding: 10px;'} Start Camera

:plain
  <script type="module">
    import * as vision from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision/vision_bundle.js";
    window.vision = vision;
    $(document).ready(function() {
      // Ensure the Face Check-In button opens the modal
      $('#face-checkin-btn').click(function() {
        $('#faceCheckInModal').modal('show');
      });
      var video = document.getElementById('face-video');
      var canvas = document.getElementById('face-canvas');
      var ctx = canvas.getContext('2d');
      var stream = null;
      var autoCaptureActive = false;
      var faceLandmarker = null;
      var lastVideoTime = -1;

      async function loadFaceLandmarker() {
        const visionWasm = await vision.FilesetResolver.forVisionTasks(
          'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@latest/wasm'
        );
        faceLandmarker = await vision.FaceLandmarker.createFromOptions(visionWasm, {
          baseOptions: { modelAssetPath: 'https://storage.googleapis.com/mediapipe-assets/face_landmarker.task' },
          runningMode: 'VIDEO',
          numFaces: 1,
          minFaceDetectionConfidence: 0.8,
          minFacePresenceConfidence: 0.8,
          minTrackingConfidence: 0.8
        });
      }

      function showAutoFaceStatus(message, type) {
        $('#auto-face-status-message')
          .removeClass()
          .addClass('alert alert-' + type)
          .text(message)
          .show();
      }
      function hideAutoFaceStatus() {
        $('#auto-face-status-message').hide();
      }

      async function startAutoCapture() {
        if (!faceLandmarker) await loadFaceLandmarker();
        autoCaptureActive = true;
        showAutoFaceStatus('Align your face to the camera. Waiting for a clear, straight face...', 'info');
        requestAnimationFrame(autoCaptureLoop);
      }

      async function autoCaptureLoop() {
        if (!autoCaptureActive) return;
        if (video.readyState < 2) {
          requestAnimationFrame(autoCaptureLoop);
          return;
        }
        if (!faceLandmarker) {
          requestAnimationFrame(autoCaptureLoop);
          return;
        }
        if (video.currentTime === lastVideoTime) {
          requestAnimationFrame(autoCaptureLoop);
          return;
        }
        lastVideoTime = video.currentTime;
        const results = faceLandmarker.detectForVideo(video, performance.now());
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        if (results.faceLandmarks && results.faceLandmarks.length > 0) {
          // Check if face is straight and centered
          const landmarks = results.faceLandmarks[0];
          const leftEye = landmarks[33];
          const rightEye = landmarks[263];
          const noseTip = landmarks[1];
          const eyeDiffY = Math.abs(leftEye.y - rightEye.y);
          const minEyeX = Math.min(leftEye.x, rightEye.x);
          const maxEyeX = Math.max(leftEye.x, rightEye.x);
          const noseBetweenEyes = (noseTip.x > minEyeX && noseTip.x < maxEyeX);
          const faceCentered = Math.abs(noseTip.x - 0.5) < 0.1;
          if (eyeDiffY < 0.03 && noseBetweenEyes && faceCentered) {
            showAutoFaceStatus('Face detected and aligned! Capturing...', 'success');
            autoCaptureActive = false;
            setTimeout(captureAndSubmit, 500);
            return;
          } else {
            showAutoFaceStatus('Please look straight at the camera and center your face.', 'warning');
          }
        } else {
          showAutoFaceStatus('No face detected. Please align your face.', 'danger');
        }
        requestAnimationFrame(autoCaptureLoop);
      }

      function captureAndSubmit() {
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        canvas.toBlob(function(blob) {
          var formData = new FormData();
          formData.append('image', blob, 'capture.jpg');
          fetch('/api/face/recognize', {
            method: 'POST',
            body: formData
          })
          .then(response => response.json())
          .then(function(response) {
            if (response.success && response.user_id) {
              // Now, check in this user via Rails
              $.ajax({
                url: '/attendances/face_check_in_submit',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ user_id: response.user_id }),
                xhrFields: { withCredentials: true },
                success: function(attendanceResp) {
                  if (attendanceResp.success) {
                    showAutoFaceStatus('Check-in successful! Welcome, ' + response.user_name + '.', 'success');
                    setTimeout(function() {
                      $('#faceCheckInModal').modal('hide');
                      location.reload();
                    }, 2000);
                  } else {
                    showAutoFaceStatus('Check-in failed: ' + (attendanceResp.error || 'Unknown error'), 'danger');
                  }
                },
                error: function(xhr, status, error) {
                  showAutoFaceStatus('Error checking in: ' + error, 'danger');
                },
                complete: function() {
                  autoCaptureActive = true;
                  requestAnimationFrame(autoCaptureLoop);
                }
              });
            } else {
              showAutoFaceStatus('Face not recognized: ' + (response.error || 'Unknown error'), 'danger');
              autoCaptureActive = true;
              requestAnimationFrame(autoCaptureLoop);
            }
          })
          .catch(function(error) {
            showAutoFaceStatus('Error recognizing face: ' + error, 'danger');
            autoCaptureActive = true;
            requestAnimationFrame(autoCaptureLoop);
          });
        }, 'image/jpeg', 0.8);
      }

      $('#face-start-camera-btn').click(function() {
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
          navigator.mediaDevices.getUserMedia({ 
            video: { 
              width: { ideal: 640 },
              height: { ideal: 480 },
              facingMode: 'user'
            } 
          })
          .then(function(mediaStream) {
            stream = mediaStream;
            video.srcObject = mediaStream;
            video.play();
            $('#face-start-camera-btn').hide();
            startAutoCapture();
          })
          .catch(function(err) {
            showAutoFaceStatus('Error accessing camera. Please check permissions.', 'danger');
          });
        } else {
          showAutoFaceStatus('Camera not supported in this browser.', 'danger');
        }
      });

      $('#faceCheckInModal').on('hidden.bs.modal', function() {
        if (stream) {
          stream.getTracks().forEach(function(track) {
            track.stop();
          });
          stream = null;
        }
        $('.video-container').show();
        $('.canvas-container').hide();
        $('#face-start-camera-btn').show();
        autoCaptureActive = false;
        hideAutoFaceStatus();
      });
    });
  </script>

.text-center.custom-font
  %p Start timers and easily manage your existing time entries in just one tap.
