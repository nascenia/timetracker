- content_for :head do
  %meta{name: "viewport", content: "width=device-width, initial-scale=1"}

.text-center.custom-font
  %h1 Nascenia Time & Leave Tracker
  %p Time & Leave tracking made smart!
  %hr

.row
  .col-md-4.col-md-offset-4
    = link_to 'Sign in with Google', user_omniauth_authorize_path(:google_oauth2), :class => 'btn btn-block btn-primary'

%h3.text-center Or

.row
  .col-md-4.col-md-offset-4
    = form_for(resource, as: resource_name, url: session_path(resource_name), class: 'form-horizontal') do |f|
      .form-group    
        = f.label :email
        = f.email_field :email, autofocus: true, class: 'form-control'
      .form-group
        = f.label :password
        = f.password_field :password, autocomplete: 'off', class: 'form-control'
      .form-group
        = f.submit 'Sign In', class: 'btn btn-primary btn-block'

// Face Check-In Button
- if defined?(request) && Attendance::IP_WHITELIST.include?(request.remote_ip)
  .text-center
    %button#face-checkin-btn.btn.btn-success{type: 'button', style: 'margin-top: 20px;'}
      Face Check-In (with Camera)

/ Face Check-In Modal
#faceCheckInModal.modal.fade{tabindex: '-1', :role => 'dialog', 'aria-labelledby' => 'faceCheckInModalLabel'}
  .modal-dialog.modal-lg{:role => 'document'}
    .modal-content
      .modal-header
        %button.close{type: 'button', 'data-dismiss' => 'modal', 'aria-label' => 'Close'}
          %span{'aria-hidden' => 'true'} &times;
        %h4.modal-title#faceCheckInModalLabel Face Check-In
      .modal-body
        .row
          .col-xs-12
            / Centered container for camera and status messages
            .camera-container.text-center
              .video-container{style: 'width: 100%; max-width: 200px; margin: 0 auto;'}
                %video#face-video{autoplay: true, muted: true, playsinline: true, style: 'width: 100%; height: auto; border-radius: 50%; aspect-ratio: 1 / 1; object-fit: cover; background: #222; box-shadow: 0 0 0 4px #fff, 0 0 8px 0 #888; transform: scaleX(-1);'}
              .canvas-container.text-center{style: 'display: none; width: 100%; max-width: 200px; margin: 0 auto;'}
                %canvas#face-canvas{width: '200', height: '200', style: 'width: 100%; height: auto; border-radius: 50%; aspect-ratio: 1 / 1; object-fit: cover; background: #222; box-shadow: 0 0 0 4px #fff, 0 0 8px 0 #888;'}
              / Status messages centered below camera
              #auto-face-status-message.alert{style: 'display: none; margin-top: 10px;'}
              #pose-feedback.alert{style: 'display: none; margin-top: 10px;'}
              #countdown-feedback.alert{style: 'display: none; margin-top: 10px; font-size: 1.2em; font-weight: bold;'}
        
        .row
          .col-xs-12.col-md-8.col-md-offset-2
            .instructions
              %h5 Instructions:
              %ol
                %li Click "Start Camera" to begin
                %li Bring your face close so it fills the circle
                %li Ensure good lighting and look straight at the camera
                %li After 3 seconds countdown photos will be captured automatically
                %li#face-glasses-instruction(style='display:none;') Please take off your glasses
            .status-messages
              #face-status-message.alert{style: 'display: none;'}
      .modal-footer
        %button.btn.btn-default{type: 'button', 'data-dismiss' => 'modal'} Close
        %button#face-start-camera-btn.btn.btn-primary.btn-block{type: 'button', style: 'font-size: 1.2em; padding: 10px;'} Start Camera

:plain
  <script type="module">
    $(document).ready(function() {
      let video = document.getElementById('face-video');
      let stream = null;
      let canvas = document.createElement('canvas');
      let ctx = canvas.getContext('2d');
      const FRAME_COUNT = 5;
      const CAPTURE_INTERVAL = 100; // ms (5 frames in 1 second)
      const COUNTDOWN_SECONDS = 3;
      let frames = [];
      let deviceType = /Mobi|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ? 'mb' : 'pc';

      function showStatus(msg, type='info') {
        $('#auto-face-status-message').removeClass().addClass('alert alert-' + type).text(msg).show();
      }
      function hideStatus() {
        $('#auto-face-status-message').hide();
      }
      function resetModal() {
        $('.video-container').show();
        $('.canvas-container').hide();
        $('#face-start-camera-btn').show();
        hideStatus();
        if (video && video.srcObject) video.play();
      }
      async function startCamera() {
        if (stream) return;
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
        video.srcObject = stream;
        video.play();
      }
      function setCanvasSize() {
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
      }
      async function countdown(seconds) {
        for (let i = seconds; i > 0; i--) {
          showStatus(`Get ready! Liveness check will start in ${i}...`, 'info');
          await new Promise(res => setTimeout(res, 1000));
      }
      }
      async function captureFrames() {
        frames = [];
        setCanvasSize();
        for (let i = 0; i < FRAME_COUNT; i++) {
          ctx.save();
          ctx.translate(canvas.width, 0);
          ctx.scale(-1, 1); // Non-mirrored
          ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
          ctx.restore();
          let blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 1));
          frames.push(blob);
          showStatus(`Capturing liveness video... (${i+1}/${FRAME_COUNT})`, 'info');
          await new Promise(res => setTimeout(res, CAPTURE_INTERVAL));
        }
      }
      async function runLivenessAndRecognitionUnified() {
        try {
          await startCamera();
          showStatus('Position your face in the center. Ensure good lighting.', 'info');
          await new Promise(res => setTimeout(res, 1000));
          await countdown(COUNTDOWN_SECONDS);
          await captureFrames();

          showStatus('Checking liveness and recognizing face...', 'info');
          let formData = new FormData();
          frames.forEach((frame, idx) => formData.append('frames[]', frame, `frame${idx}.jpg`));
          formData.append('device_type', deviceType);
          let response = await fetch('/api/face/liveness_and_recognition', { method: 'POST', body: formData });
          let result = await response.json();
          if (result.success && result.user_id) {
            showStatus('✅ Liveness check passed and face recognized!' + (result.user_name ? (' For ' + result.user_name) : ''), 'success');
            setTimeout(function() {
              window.location.href = '/';
            }, 500);
          } else {
            showStatus('❌ ' + (result.error || 'Liveness or recognition failed.'), 'danger');
            setTimeout(() => restartProcess(), 2500);
          }
        } catch (e) {
          showStatus('Error: ' + e, 'danger');
          setTimeout(() => restartProcess(), 2500);
        }
      }
      function restartProcess() {
        if (stream) {
          stream.getTracks().forEach(track => track.stop());
          stream = null;
        }
        frames = [];
        hideStatus();
        $('#face-start-camera-btn').show();
                $('.video-container').show();
                $('.canvas-container').hide();
        if (video && video.srcObject) video.pause();
      }
      // Update button click handler to use the new function
      $('#face-start-camera-btn').click(function() {
        $('#face-start-camera-btn').hide();
        runLivenessAndRecognitionUnified();
      });
      $('#faceCheckInModal').on('hidden.bs.modal', function() {
        if (stream) {
          stream.getTracks().forEach(track => track.stop());
          stream = null;
        }
        frames = [];
        hideStatus();
        $('#face-start-camera-btn').show();
        $('.video-container').show();
        $('.canvas-container').hide();
        if (video && video.srcObject) video.pause();
      });
      $('#face-checkin-btn').click(function() {
        $('#faceCheckInModal').modal('show');
      });
      // Show glasses instruction for PC only
      if (deviceType === 'pc') {
        $('#face-glasses-instruction').show();
      }
    });
  </script>

.text-center.custom-font
  %p Start timers and easily manage your existing time entries in just one tap.