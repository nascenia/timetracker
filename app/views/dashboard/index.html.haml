.log-status
  - unless @attendance.present?
    .alert.alert-warning{:role => 'alert'}
      Please check in!
  - else
    .alert.alert-info{:role => 'alert'}
      Today's in time
      %b= "#{@attendance.in_time.strftime('%I:%M %p')} "
      - unless is_late_attendance? @attendance.in_time
        %span.label.label-success On time
      - else
        %span.label.label-danger Late

  .row
    .col-sm-3
      - if @attendance.present? && @attendance.out_time.blank?
        = link_to 'Check In', attendances_path, :method => :post, :class => "btn btn-block btn-bottom-margin #{is_checked_in? @attendance}"
      - else
        - if current_user.face_recognition_required?
          - if defined?(request) && Attendance::IP_WHITELIST.include?(request.remote_ip)
            = button_tag 'Check In', type: 'button', id: 'face-checkin-dashboard-btn', class: "btn btn-block btn-bottom-margin btn-success m-zero-x"
          - else
            = link_to 'Check In', '', :class => "btn btn-block btn-bottom-margin btn-success show-network-alert"
        - else
          - if defined?(request) && Attendance::IP_WHITELIST.include?(request.remote_ip)
            = link_to 'Check In', attendances_path, :method => :post, :class => "btn btn-block btn-bottom-margin #{is_checked_in? @attendance}"
          - else
            = link_to 'Check In', '', :class => "btn btn-block btn-bottom-margin btn-success show-network-alert"
    - unless @attendance.nil?
      .col-sm-3
        - if current_user.face_recognition_required?
          - if defined?(request) && Attendance::IP_WHITELIST.include?(request.remote_ip)
            = button_tag 'Check Out', type: 'button', id: 'face-checkout-dashboard-btn', class: "btn btn-block btn-bottom-margin #{is_checked_out? @attendance} m-zero-x"
          - else
            = link_to 'Check Out', '', :class => "btn btn-block #{is_checked_out? @attendance} show-network-alert btn-bottom-margin"
        - else
          - if defined?(request) && Attendance::IP_WHITELIST.include?(request.remote_ip)
            = link_to 'Check Out', attendance_path(@attendance), :method => :put, :class => "btn btn-block #{is_checked_out? @attendance} btn-bottom-margin"
          - else
            = link_to 'Check Out', '', :class => "btn btn-block #{is_checked_out? @attendance} show-network-alert btn-bottom-margin"

/ Face Check-In Modal (copied from devise/sessions/new.html.haml)
- if current_user.face_recognition_required? && defined?(request) && Attendance::IP_WHITELIST.include?(request.remote_ip)
  #faceCheckInModal.modal.fade{tabindex: '-1', :role => 'dialog', 'aria-labelledby' => 'faceCheckInModalLabel'}
    .modal-dialog.modal-lg{:role => 'document'}
      .modal-content
        .modal-header
          %button.close{type: 'button', 'data-dismiss' => 'modal', 'aria-label' => 'Close'}
            %span{'aria-hidden' => 'true'} &times;
          %h4.modal-title#faceCheckInModalLabel Face Check-In
        .modal-body
          .row
            .col-xs-12
              / Centered container for camera and status messages
              .camera-container.text-center
                .video-container{style: 'width: 100%; max-width: 200px; margin: 0 auto;'}
                  %video#face-video{autoplay: true, muted: true, playsinline: true, style: 'width: 100%; height: auto; border-radius: 50%; aspect-ratio: 1 / 1; object-fit: cover; background: #222; box-shadow: 0 0 0 4px #fff, 0 0 8px 0 #888; transform: scaleX(-1);'}
                .canvas-container.text-center{style: 'display: none; width: 100%; max-width: 200px; margin: 0 auto;'}
                  %canvas#face-canvas{width: '200', height: '200', style: 'width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; background: #222; box-shadow: 0 0 0 4px #fff, 0 0 8px 0 #888;'}
                / Status messages centered below camera
                #auto-face-status-message.alert{style: 'display: none; margin-top: 10px;'}
                #pose-feedback.alert{style: 'display: none; margin-top: 10px;'}
                #countdown-feedback.alert{style: 'display: none; margin-top: 10px; font-size: 1.2em; font-weight: bold;'}
          
          .row
            .col-xs-12.col-md-8.col-md-offset-2
              .instructions
                %h5 Instructions:
                %ol
                  %li Click "Start Camera" to begin
                  %li Bring your face close so it fills the circle
                  %li Ensure good lighting and look straight at the camera
                  %li After 2 seconds countdown photos will be captured automatically
                  %li For better accuracy, please use your phone instead of a PC
                  %li#face-glasses-instruction(style='display:none;') Please take off your glasses
              .status-messages
                #face-status-message.alert{style: 'display: none;'}
        .modal-footer
          %button.btn.btn-default{type: 'button', 'data-dismiss' => 'modal'} Close
          %button#face-start-camera-btn.btn.btn-primary.btn-block{type: 'button', style: 'font-size: 1.2em; padding: 10px;'} Start Camera

.row
  .col-md-8
    = render 'todays_attendance'

  .col-md-4
    = render 'attendance_summary'
    - if @all_approved_leaves.count > 0
      = render 'on_leave_users'
    = render 'internal_services'
    = render 'rules_instructions'
    - if current_user.present? && current_user.has_admin_privilege?
      = render 'attendance_reports'

.row
  #salaat-summary &nbsp;

:javascript
  $(document).on('click', '.monthly-summary', function() {
    var user = {
      id: $(this).data().userId,
      month: $(this).data().userMonth,
      year: $(this).data().userYear
    };

    $.ajax({
      url: "/attendances/monthly_summary",
      type: "GET",
      data:  { user: user },
      beforeSend: function() {
        $("#modal-loading-image").show();
      },
      success: function(msg) {
        $("#modal-loading-image").hide();
      }
    });
  });

  $(document).on('click', '#rules', function() {
    $("#rulesModal").modal('show');
  });

  $(document).ready(function() {
    var countdownTimer;
    // Set action type on the modal before showing it
    $('#face-checkin-dashboard-btn').on('click', function() {
      $.ajax({
        url: "/attendances/store_check_in_time",
        type: "POST",
        success: function(msg) {
          $('#faceCheckInModal')
            .data('action-type', 'checkin')
            .modal('show');
        }
      });
    });

    $('#face-checkout-dashboard-btn').on('click', function() {
      $('#faceCheckInModal')
        .data('action-type', 'checkout')
        .modal('show');
    });

    $('#faceCheckInModal').on('shown.bs.modal', function (e) {
      if ($('#faceCheckInModal').data('action-type') == 'checkin') {
        var twoMinutes = 60 * 2,
            display = $('#countdown-feedback');
        display.show();
        startTimer(twoMinutes, display);
      }
    });

    function startTimer(duration, display) {
      var timer = duration, minutes, seconds;
      countdownTimer = setInterval(function () {
        minutes = parseInt(timer / 60, 10)
        seconds = parseInt(timer % 60, 10);

        minutes = minutes < 10 ? "0" + minutes : minutes;
        seconds = seconds < 10 ? "0" + seconds : seconds;

        display.text("Time left: " + minutes + ":" + seconds);

        if (--timer < 0) {
          clearInterval(countdownTimer);
          $('#faceCheckInModal').modal('hide');
        }
      }, 1000);
    }

    $('#faceCheckInModal').on('hidden.bs.modal', function () {
      clearInterval(countdownTimer);
      $('#countdown-feedback').hide();
    });

    $(document).on('click', '.show-network-alert', function(e) {
      e.preventDefault();
      $('.network-restriction-alert').remove();
      var alertHtml = '<div class="alert alert-danger alert-dismissible network-restriction-alert" role="alert">' +
                      '<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>' +
                      'Check-in/Check-out outside the office network is restricted.' +
                      '</div>';
      $('.log-status').prepend(alertHtml);
    });
  });
