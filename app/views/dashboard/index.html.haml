.log-status
  - unless @attendance.present?
    .alert.alert-warning{:role => 'alert'}
      Please check in!
  - else
    .alert.alert-info{:role => 'alert'}
      Today's in time
      %b= "#{@attendance.in_time.strftime('%I:%M %p')} "
      - unless is_late_attendance? @attendance.in_time
        %span.label.label-success On time
      - else
        %span.label.label-danger Late

  .row
    .col-sm-3
      - if @attendance.present? && @attendance.out_time.blank?
        = link_to 'Check In', attendances_path, :method => :post, :class => "btn btn-block btn-bottom-margin #{is_checked_in? @attendance}"
      - elsif defined?(request) && Attendance::IP_WHITELIST.include?(request.remote_ip) && current_user.face_recognition_required?
        = link_to 'Check In', attendances_path, :method => :post, :id => 'real-checkin-btn', :style => 'display:none;', :class => "btn btn-block btn-bottom-margin #{is_checked_in? @attendance}"
        = button_tag 'Check In', type: 'button', id: 'face-checkin-dashboard-btn', class: "btn btn-block btn-bottom-margin btn-success", :style => 'margin: 0;'
      - else
        = link_to 'Check In', attendances_path, :method => :post, :class => "btn btn-block btn-bottom-margin #{is_checked_in? @attendance}"

    - unless @attendance.nil?
      .col-sm-3
        - if defined?(request) && Attendance::IP_WHITELIST.include?(request.remote_ip) && current_user.face_recognition_required?
          = link_to 'Check Out', attendance_path(@attendance), :method => :put, :id => 'real-checkout-btn', :style => 'display:none;', :class => "btn btn-block #{is_checked_out? @attendance}"
          = button_tag 'Check Out', type: 'button', id: 'face-checkout-dashboard-btn', class: "btn btn-block #{is_checked_out? @attendance}" , :style => 'margin: 0;'
        - else
          = link_to 'Check Out', attendance_path(@attendance), :method => :put, :class => "btn btn-block #{is_checked_out? @attendance}"

/ Face Check-In Modal (copied from devise/sessions/new.html.haml)
- if defined?(request) && Attendance::IP_WHITELIST.include?(request.remote_ip) && current_user.face_recognition_required?
  #faceCheckInModal.modal.fade{tabindex: '-1', :role => 'dialog', 'aria-labelledby' => 'faceCheckInModalLabel'}
    .modal-dialog.modal-lg{:role => 'document'}
      .modal-content
        .modal-header
          %button.close{type: 'button', 'data-dismiss' => 'modal', 'aria-label' => 'Close'}
            %span{'aria-hidden' => 'true'} &times;
          %h4.modal-title#faceCheckInModalLabel Face Check-In
        .modal-body
          .row
            .col-xs-12
              / Centered container for camera and status messages
              .camera-container.text-center
                .video-container{style: 'width: 100%; max-width: 200px; margin: 0 auto;'}
                  %video#face-video{autoplay: true, muted: true, playsinline: true, style: 'width: 100%; height: auto; border-radius: 50%; aspect-ratio: 1 / 1; object-fit: cover; background: #222; box-shadow: 0 0 0 4px #fff, 0 0 8px 0 #888; transform: scaleX(-1);'}
                .canvas-container.text-center{style: 'display: none; width: 100%; max-width: 200px; margin: 0 auto;'}
                  %canvas#face-canvas{width: '200', height: '200', style: 'width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; background: #222; box-shadow: 0 0 0 4px #fff, 0 0 8px 0 #888;'}
                / Status messages centered below camera
                #auto-face-status-message.alert{style: 'display: none; margin-top: 10px;'}
                #pose-feedback.alert{style: 'display: none; margin-top: 10px;'}
                #countdown-feedback.alert{style: 'display: none; margin-top: 10px; font-size: 1.2em; font-weight: bold;'}
          
          .row
            .col-xs-12.col-md-8.col-md-offset-2
              .instructions
                %h5 Instructions:
                %ol
                  %li Click "Start Camera" to begin
                  %li Bring your face close so it fills the circle
                  %li Ensure good lighting and look straight at the camera
                  %li After 3 seconds countdown photos will be captured automatically
                  %li#face-glasses-instruction(style='display:none;') Please take off your glasses
              .status-messages
                #face-status-message.alert{style: 'display: none;'}
        .modal-footer
          %button.btn.btn-default{type: 'button', 'data-dismiss' => 'modal'} Close
          %button#face-start-camera-btn.btn.btn-primary.btn-block{type: 'button', style: 'font-size: 1.2em; padding: 10px;'} Start Camera

.row
  .col-md-8
    = render 'todays_attendance'

  .col-md-4
    = render 'attendance_summary'
    - if @all_approved_leaves.count > 0
      = render 'on_leave_users'
    = render 'internal_services'
    = render 'rules_instructions'
    - if current_user.present? && current_user.has_admin_privilege?
      = render 'attendance_reports'

.row
  #salaat-summary &nbsp;

:javascript
  $(document).on('click', '.monthly-summary', function() {
    var user = {
      id: $(this).data().userId,
      month: $(this).data().userMonth,
      year: $(this).data().userYear
    };

    $.ajax({
      url: "/attendances/monthly_summary",
      type: "GET",
      data:  { user: user },
      beforeSend: function() {
        $("#modal-loading-image").show();
      },
      success: function(msg) {
        $("#modal-loading-image").hide();
      }
    });
  });

  $(document).on('click', '#rules', function() {
    $("#rulesModal").modal('show');
  });

  $(document).ready(function() {
    // Countdown state for Face Check-In
    var checkinCountdownInterval = null;
    var checkinCountdownDeadline = null; // epoch ms
    var checkinInitialClickIso = null;   // ISO8601 string

    function formatTimeLeft(ms) {
      var totalSeconds = Math.max(0, Math.floor(ms / 1000));
      var minutes = Math.floor(totalSeconds / 60);
      var seconds = totalSeconds % 60;
      return (minutes < 10 ? '0' + minutes : minutes) + ':' + (seconds < 10 ? '0' + seconds : seconds);
    }

    function startCheckinCountdown() {
      // 2 minutes from now
      checkinCountdownDeadline = Date.now() + (2 * 60 * 1000);
      $('#countdown-feedback').removeClass().addClass('alert alert-info').text('Time left: 02:00').show();
      if (checkinCountdownInterval) { clearInterval(checkinCountdownInterval); }
      checkinCountdownInterval = setInterval(function() {
        var msLeft = checkinCountdownDeadline - Date.now();
        if (msLeft <= 0) {
          clearInterval(checkinCountdownInterval);
          checkinCountdownInterval = null;
          $('#countdown-feedback').removeClass().addClass('alert alert-danger').text('⏰ Time expired. Please click Check In again.');
          // Also stop camera via existing modal close logic
          setTimeout(function() { try { $('#faceCheckInModal').modal('hide'); } catch(e) {} }, 1200);
        } else {
          var text = 'Time left: ' + formatTimeLeft(msLeft);
          var $el = $('#countdown-feedback');
          if (msLeft <= 30 * 1000) {
            $el.removeClass().addClass('alert alert-warning').text(text);
          } else {
            $el.removeClass().addClass('alert alert-info').text(text);
          }
        }
      }, 500);
    }

    function clearCheckinCountdown() {
      if (checkinCountdownInterval) { clearInterval(checkinCountdownInterval); checkinCountdownInterval = null; }
      checkinCountdownDeadline = null;
      $('#countdown-feedback').hide();
    }

    // Check In logic
    if ($('#face-checkin-dashboard-btn').length > 0) {
      $('#face-checkin-dashboard-btn').click(function() {
        // Record the initial click time (used as in_time on server)
        var checkinInitialClickMs = Date.now();
        checkinInitialClickIso = new Date(checkinInitialClickMs).toISOString();
        startCheckinCountdown();
        window.onFaceCheckinSuccess = function() {
          // Allow success only within countdown window
          if (checkinCountdownDeadline && Date.now() <= checkinCountdownDeadline) {
            // Ensure the real check-in POST includes the initial click time
            var $real = $('#real-checkin-btn');
            var baseHref = ($real.attr('href') || '/attendances').split('?')[0];
            // Send both ISO string and epoch ms; server prefers ms
            var params = 'initial_click_time=' + encodeURIComponent(checkinInitialClickIso) + '&initial_click_time_ms=' + checkinInitialClickMs;
            var newHref = baseHref + '?' + params;
            $real.attr('href', newHref);
            $('#faceCheckInModal').modal('hide');
            $real.click();
          } else {
            $('#countdown-feedback').removeClass().addClass('alert alert-danger').text('⏰ Time expired. Please click Check In again.');
            setTimeout(function() { try { $('#faceCheckInModal').modal('hide'); } catch(e) {} }, 800);
          }
        };
        $('#faceCheckInModal').modal('show');
      });
    }
    // Check Out logic
    if ($('#face-checkout-dashboard-btn').length > 0) {
      $('#face-checkout-dashboard-btn').click(function() {
        window.onFaceCheckinSuccess = function() {
          $('#faceCheckInModal').modal('hide');
          $('#real-checkout-btn').click();
        };
        $('#faceCheckInModal').modal('show');
      });
    }

    // When modal closes, clear countdown state
    $('#faceCheckInModal').on('hidden.bs.modal', function() {
      clearCheckinCountdown();
    });
  });
